<?xml version="1.0" encoding="utf-8"?>
<!-- Launch splash (API 21+): deep ListenGood purple with the logo centered -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="315"
                android:startColor="#5B1FA8"
                android:centerColor="#3A1478"
                android:endColor="#2A0F5C" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="112dp"
        android:height="112dp">
        <bitmap
            android:src="@mipmap/launcher_icon"
            android:gravity="center" />
    </item>
</layer-list>
